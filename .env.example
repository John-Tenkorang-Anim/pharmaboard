PHARMABOARD_ENV=development
PHARMABOARD_HTTP_ADDR=:8080
PHARMABOARD_DATABASE_URL=postgres://pharmaboard:pharmaboard@localhost:5432/pharmaboard?sslmode=disable
PHARMABOARD_LOG_LEVEL=debug
# Shared secret for the one-time admin bootstrap call (POST /v1/admin/bootstrap).
# Required to grant the first publisher_admin role; generate a real random
# value outside development and never commit it.
PHARMABOARD_ADMIN_BOOTSTRAP_TOKEN=dev-bootstrap-secret
# Comma-separated CORS allowlist, required in production so the web console
# (or any other browser client) can call this API cross-origin. Ignored in
# development, where Origin is reflected instead so the console can run on
# any local dev port.
PHARMABOARD_ALLOWED_ORIGINS=https://console.pharmaboard.example
