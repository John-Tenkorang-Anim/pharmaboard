{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Type-check vite.config.ts without emitting vite.config.js/.d.ts next to
    // the source — those artifacts were previously produced (and committed)
    // as a side effect of `tsc -b`.
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
